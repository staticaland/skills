# Skills vendored by vendir. Upstream writes these files, so this repository
# does not format or lint them, and a reformat would be undone by the next
# `vendir sync`. The same list lives in `.rumdl.toml` and in the empty-styles
# section in `.vale.ini`.
plugins/retro/skills/retro/
plugins/skill-authoring/skills/writing-for-agents/
plugins/browser/skills/agent-browser/
plugins/grilling/skills/domain-modeling/
plugins/pull-requests/skills/gh-stack/
plugins/grilling/skills/grill-me/
plugins/grilling/skills/grill-with-docs/
plugins/grilling/skills/grilling/
plugins/toolchain/skills/prek/
plugins/plain-language/skills/bro/
plugins/plain-language/skills/wait-what/
plugins/prose/skills/unslop/

# Pull request templates. Their prose is one paragraph per line, because GitHub
# reflows the markdown and a hard wrap only makes the description awkward to
# edit. Prettier leaves prose alone at its default `proseWrap`, so this entry
# guards against a later config change. rumdl disables `MD013` (line length)
# for the whole repository in `.rumdl.toml`.
.github/PULL_REQUEST_TEMPLATE.md
plugins/pull-requests/skills/create-pr/references/pr-template.md

# Per-plugin changelogs that release-please generates. The bot's markdown is
# not prettier-shaped, and reformatting it would churn every release PR.
plugins/*/CHANGELOG.md

# Lockfile that `vendir sync` writes. Prettier and vendir disagree on its
# shape, and a reformat would be undone by the next sync.
vendir.lock.yml
