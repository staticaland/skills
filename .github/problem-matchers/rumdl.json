{
  "problemMatcher": [
    {
      "owner": "rumdl",
      "pattern": [
        {
          "regexp": "^\\s*([^:\\s]+):(\\d+):(\\d+): \\[([A-Z0-9]+)\\] (.+?)(?: \\[\\*\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
