{
  "problemMatcher": [
    {
      "owner": "markdownlint-cli2",
      "pattern": [
        {
          "regexp": "^\\s*([^:\\s]+):(\\d+)(?::(\\d+))? (error|warning) ([\\w/-]+) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
